filters:
  and:
    - 'file.ext == "md"'
  not:
    - file.hasTag("status/archived")

formulas:
  age_days: '(now() - file.ctime).days.round(0)'

properties:
  formula.age_days:
    displayName: "Age (days)"

views:
  - type: table
    name: "Recent Activity"
    limit: 30
    order:
      - file.name
      - type
      - source_project
      - confidence
      - formula.age_days
