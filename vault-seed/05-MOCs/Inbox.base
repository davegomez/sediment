filters:
  and:
    - file.inFolder("00-Inbox")
    - file.hasTag("status/unreviewed")

formulas:
  age_days: '(now() - file.ctime).days.round(0)'

properties:
  formula.age_days:
    displayName: "Age (days)"

views:
  - type: table
    name: "Unreviewed Notes"
    order:
      - file.name
      - type
      - source_project
      - confidence
      - formula.age_days
    groupBy:
      property: type
      direction: ASC
