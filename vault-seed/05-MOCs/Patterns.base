filters:
  and:
    - file.hasTag("type/pattern")
    - 'file.ext == "md"'

formulas:
  age_days: '(now() - file.ctime).days.round(0)'

properties:
  formula.age_days:
    displayName: "Age (days)"

views:
  - type: table
    name: "All Patterns"
    order:
      - file.name
      - source_project
      - confidence
      - date_created
      - formula.age_days
